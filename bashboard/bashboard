# Environmental
[ -f "$HOME/.tether_paths" ] && export TETHER_PATHS="$(tr '\n' ':' < "$HOME/.tether_paths" | sed 's/:$//')"

# Alias Land
alias editBB="vi ~/.bashboard"
alias refreshBB="source ~/.bashboard"
alias home="cd $HOME"
alias code="gnome-keyring-daemon --start --components=pkcs11,secrets,ssh,gpg && code"
alias oldfile="find . -maxdepth 1 -type f -printf '%T@ %p\n' | sort -n | tail -n1"
alias newfile="find . -maxdepth 1 -type f -printf '%T@ %p\n' | sort -n | head -n1"
alias olddir="find . -maxdepth 1 -type d -printf '%T@ %p\n' | sort -n | tail -n1"
